// Weight types of mixed-precision GGUFs (ISTA-DASLab's Qwen3.8 release):
// Q2_0, Q5_0, IQ4_NL, Q3_K, Q5_K, Q6_K, IQ4_XS, BF16 and the codebook quants
// IQ2_XS, IQ2_S, IQ3_XXS and IQ3_S of its IQ3_XXS file. Block layouts,
// dequantizers and matvec kernels follow llama.cpp's Metal backend (MIT).
// Every dequantizer returns elements in natural order: il selects 16
// consecutive weights (the _t4 variants 4), so kernel_mul_mm and the
// mul_mv_ext template in dense.metal can use them unchanged. Q5_K and Q6_K
// reuse the blocks and 4x4 dequantizers of moe.metal.

#ifndef QK_K
#define QK_K 256
#endif
#define QK2_0 64

struct block_q2_0 {
    half d;
    uchar qs[QK2_0/4];
};

struct block_q5_0 {
    half d;
    uchar qh[4];
    uchar qs[16];
};

struct block_iq4_nl {
    half d;
    uchar qs[16];
};

struct block_q3_K {
    uchar hmask[QK_K/8];
    uchar qs[QK_K/4];
    uchar scales[12];
    half d;
};

struct block_iq4_xs {
    half d;
    ushort scales_h;
    uchar scales_l[QK_K/64];
    uchar qs[QK_K/2];
};

struct block_iq2_xs {
    half d;
    ushort qs[QK_K/8];
    uchar scales[QK_K/32];
};

struct block_iq2_s {
    half d;
    uchar qs[QK_K/4];
    uchar qh[QK_K/32];
    uchar scales[QK_K/32];
};

struct block_iq3_xxs {
    half d;
    uchar qs[3*QK_K/8];
};

struct block_iq3_s {
    half d;
    uchar qs[QK_K/4];
    uchar qh[QK_K/32];
    uchar signs[QK_K/8];
    uchar scales[QK_K/64];
};

// 16 BF16 weights, the kernel_mul_mm block for nl = 1.
struct ds4q_bf16x16 {
    ushort v[16];
};

