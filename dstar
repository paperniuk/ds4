#!/bin/bash
# dstar: one command to run Qwen3.8-Flash-Next and the other ds4 models on an
# Apple Silicon Mac.
#
#   ./dstar pull       download the model, the MTP block and the vision encoder
#   ./dstar serve      start the OpenAI/Anthropic compatible server
#   ./dstar chat       talk to the model in the terminal
#   ./dstar doctor     check the machine, the files and the memory limit
#   ./dstar opencode   print the OpenCode provider block for this server
#   ./dstar link       make "dstar" a command that works from any directory
#
# The other models ds4 runs go through the same launcher: ./dstar models
# lists them, ./dstar pull NAME downloads one, ./dstar serve NAME runs it.
#
# It works from a source checkout (it runs make when the binaries are
# missing) and from the prebuilt package, where the binaries sit next to it.
set -e

# Follow symlinks, so the script can be linked into a directory on the PATH.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
BIN_DIR=${DSTAR_BIN:-$HOME/.local/bin}
MODELS=${DSTAR_MODELS:-$HOME/models/flash-next}
PORT=${PORT:-8010}
HOST=${HOST:-127.0.0.1}

MODEL_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
QUANT=${DSTAR_QUANT:-q2}
MTP_REPO=paperniuk/Qwen3.8-Flash-Next-MTP-block
MTP_FILE=Qwen3.8-Flash-Next-MTP-block.gguf
VISION_REPO=ggml-org/Qwen3.8-Flash-Next-GGUF
VISION_FILE=mmproj-Qwen3.8-Flash-Next-Q8_0.gguf

usage() {
    cat <<EOF
usage: dstar <command> [options]

  pull [--no-vision] [--quant iq3|iq3s]
                         download what is missing into $MODELS
                         (67 GB model, 1.5 GB MTP block, 0.6 GB vision encoder;
                         iq3 is 47 GB more, iq3s 55 GB more)
  pull NAME              download another model into ./gguf (see: dstar models)
  models                 list the other models ds4 can run
  serve [options]        start the server on http://$HOST:$PORT/v1
      --ctx N            context: 131k, 262k (default), 400k, 524k or a number
      --quant q2|iq3|iq3s
                         q2 (default) is the fast 2-bit file; iq3 is ISTA's
                         IQ3_XXS: better answers, a quarter slower, 9 GB more
                         memory, so 262k is its ceiling on 64 GB; iq3s is
                         IQ3_S, ISTA's best file, 16 GB more than q2, for
                         Macs with 96 GB or more
      --port N           port (default $PORT)
      --lan              listen on every interface (there is no authentication)
      --no-mtp           plain decoding without the speculative MTP block
      --no-vision        do not load the vision encoder
      --power N          keep the GPU busy N% of the time, 1..100: a cooler
                         and quieter Mac for a proportionally slower model
      NAME or FILE       serve another model instead: a GGUF path or a word
                         from its file name (dstar serve deepseek). The context
                         defaults to 32768, a model larger than the RAM streams
                         from the SSD, the rest goes after --
      --dry-run          print the server command instead of running it
      -- ARGS            pass the remaining arguments to ds4-server
  chat [--quant NAME] [--power N] [NAME or FILE] [-- ARGS]
                         interactive chat in the terminal
  doctor [--quant NAME]  check the machine, the files and the memory limit
  opencode               print the OpenCode provider block
  link                   link this script into $BIN_DIR, so that "dstar"
                         works from any directory (DSTAR_BIN changes the place)

Environment: DSTAR_MODELS (model directory), DSTAR_QUANT (q2, iq3 or iq3s), PORT, HOST.
EOF
}

die() { echo "dstar: $*" >&2; exit 1; }

# First existing path of the candidates, or the first candidate.
first_of() {
    for p in "$@"; do
        if [ -f "$p" ]; then echo "$p"; return; fi
    done
    echo "$1"
}

# The quants of the ISTA release. Their second shard, the n-gram table, is
# the same file in every one of them, so one copy serves all.
QUANT_TAGS="Q2_0 IQ3_XXS IQ3_S"
locate_files() {
    local tag t
    case $QUANT in
        q2) tag=Q2_0; BASE_GIB=39.1; SHARD1_GB=38 ;;
        iq3) tag=IQ3_XXS; BASE_GIB=47.9; SHARD1_GB=47 ;;
        iq3s) tag=IQ3_S; BASE_GIB=55.2; SHARD1_GB=55 ;;
        *) die "unknown quant $QUANT (q2, iq3 or iq3s)" ;;
    esac
    QDIR=$MODELS/$tag
    SHARD1=Qwen3.8-Flash-Next-GSQ-RCO-$tag-00001-of-00002.gguf
    SHARD2=Qwen3.8-Flash-Next-GSQ-RCO-$tag-00002-of-00002.gguf
    F_SHARD1=$QDIR/$SHARD1
    F_SHARD2=$QDIR/$SHARD2
    for t in $QUANT_TAGS; do
        [ -f "$F_SHARD2" ] && break
        if [ -f "$MODELS/$t/Qwen3.8-Flash-Next-GSQ-RCO-$t-00002-of-00002.gguf" ]; then
            F_SHARD2=$MODELS/$t/Qwen3.8-Flash-Next-GSQ-RCO-$t-00002-of-00002.gguf
        fi
    done
    F_MTP=$(first_of "$MODELS/$MTP_FILE" "$MODELS/mtp/$MTP_FILE")
    F_VISION=$(first_of "$MODELS/$VISION_FILE" "$HERE/gguf/$VISION_FILE")
}

ensure_binaries() {
    if [ -x "$HERE/ds4-server" ] && [ -x "$HERE/ds4" ]; then return; fi
    [ -f "$HERE/Makefile" ] || die "ds4-server is missing next to this script"
    echo "dstar: building ds4 (first run only)" >&2
    make -C "$HERE" ds4 ds4-server >&2
}

# Resumable download of one Hugging Face file. A .part file marks an
# unfinished download, so an interrupted pull continues where it stopped.
fetch() {
    local repo=$1 path=$2 out=$3
    if [ -f "$out" ]; then echo "have  $out"; return; fi
    mkdir -p "$(dirname "$out")"
    echo "fetch $repo/$path"
    if [ -n "$HF_TOKEN" ]; then
        curl -fL --progress-bar -C - -H "Authorization: Bearer $HF_TOKEN" -o "$out.part" \
            "https://huggingface.co/$repo/resolve/main/$path"
    else
        curl -fL --progress-bar -C - -o "$out.part" "https://huggingface.co/$repo/resolve/main/$path"
    fi
    mv "$out.part" "$out"
}

other_models() {
    [ -f "$HERE/download_model.sh" ] || die "download_model.sh is missing next to this script"
    cd "$HERE"   # downloads land in ./gguf
    exec sh ./download_model.sh "$@"
}

cmd_pull() {
    local vision=1
    case ${1:-} in
        ""|--*) ;;
        *) other_models "$@" ;;
    esac
    while [ $# -gt 0 ]; do
        case $1 in
            --no-vision) vision=0 ;;
            --quant) [ $# -ge 2 ] || die "--quant needs q2, iq3 or iq3s"; QUANT=$2; shift ;;
            *) die "pull: unknown option $1" ;;
        esac
        shift
    done
    locate_files
    mkdir -p "$MODELS"
    local need_gb=0 free_gb
    [ -f "$F_SHARD1" ] || need_gb=$(( SHARD1_GB + 2 ))
    [ -f "$F_SHARD2" ] || need_gb=$(( need_gb + 29 ))
    free_gb=$(df -g "$MODELS" | awk 'NR == 2 { print $4 }')
    [ "$free_gb" -ge "$need_gb" ] || die "the download needs about $need_gb GB, $MODELS has $free_gb GB free"
    fetch "$MODEL_REPO" "${QDIR##*/}/$SHARD1" "$F_SHARD1"
    fetch "$MODEL_REPO" "${QDIR##*/}/$SHARD2" "$F_SHARD2"
    fetch "$MTP_REPO" "$MTP_FILE" "$F_MTP"
    if [ "$vision" = 1 ]; then fetch "$VISION_REPO" "$VISION_FILE" "$F_VISION"; fi
    echo "Done. Start the server with: $0 serve"
}

parse_ctx() {
    case $1 in
        131k|131K) echo 131072 ;;
        262k|262K) echo 262144 ;;
        400k|400K) echo 400000 ;;
        524k|524K) echo 524288 ;;
        *[!0-9]*|"") die "--ctx takes 131k, 262k, 400k, 524k or a number of tokens" ;;
        *) echo "$1" ;;
    esac
}

# GPU memory plan with MTP and vision, in MiB: about 39.1 GiB (47.9 for the
# iq3 quant, 55.2 for iq3s) plus 33 KiB per context token, and 2 GiB of
# headroom under the wired limit.
parse_power() {
    case $1 in
        ''|*[!0-9]*) die "--power needs a number from 1 to 100" ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 100 ] || die "--power needs a number from 1 to 100"
    echo "$1"
}

need_mib() { awk -v c="$1" -v b="$BASE_GIB" 'BEGIN { printf "%d", (b + c * 3.315e-5 + 2) * 1024 }'; }

wired_limit() { sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0; }

# Does the context fit under the wired limit? A limit of 0 is the system
# default: three quarters of the RAM, which on a 64 GB machine holds 131072
# and nothing larger.
ctx_fits() {
    local ctx=$1 limit
    limit=$(wired_limit)
    if [ "$limit" = 0 ]; then
        [ "$ctx" -le 131072 ] || [ "$(need_mib "$ctx")" -le $(( RAM_GB * 768 )) ]
        return
    fi
    [ "$limit" -ge "$(need_mib "$ctx")" ]
}

sysctl_hint() {
    local need
    need=$(need_mib "$1")
    echo "sudo sysctl iogpu.wired_limit_mb=$(( (need + 2047) / 2048 * 2048 ))"
}

check_machine() {
    [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || die "this needs an Apple Silicon Mac"
    RAM_GB=$(( $(sysctl -n hw.memsize) / 1073741824 ))
}

# Absolute path of a model given by the user, so it survives the cd to $HERE.
# Anything that is not a file is a name to look for: "deepseek" finds the one
# main model GGUF with that word in its name under ./gguf or next to $MODELS.
model_path() {
    local found n
    if [ -f "$1" ] && [ "${1%.gguf}" != "$1" ]; then
        echo "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
        return
    fi
    found=$(find "$HERE/gguf" "$(dirname "$MODELS")" -maxdepth 3 -iname "*$1*.gguf" 2>/dev/null |
        grep -Eiv 'support|mmproj|mtp-block|encoder|vision\.gguf|-0*([2-9]|1[0-9])-of-' | sort -u)
    n=$(printf '%s' "$found" | grep -c . || true)
    [ "$n" != 0 ] || die "no model file or name matches: $1"
    [ "$n" = 1 ] || die "several models match $1, give the file: $(printf '\n%s' "$found")"
    echo "$found"
}

# A model larger than the RAM has to stream its experts from the SSD. Qwen
# files are the exception: most of their size is the n-gram table, which
# always stays on disk.
needs_streaming() {
    local gb
    case $(basename "$1") in *[Qq]wen*) return 1 ;; esac
    gb=$(( $(stat -L -f %z "$1") / 1073741824 ))
    [ "$gb" -ge "$RAM_GB" ]
}

# Any other model ds4 supports. Nothing here is tuned: sizing the context
# to the machine is up to the caller, as are --mtp and --vision.
serve_other() {
    local model=$1 ctx=${2:-32768} dry=$3
    shift 3
    set -- -m "$model" --ctx "$ctx" --host "$HOST" --port "$PORT" "$@"
    case " $* " in
        *" --ssd-streaming "*) ;;
        *) if needs_streaming "$model"; then
               echo "dstar: the model is larger than the RAM, streaming it from the SSD" >&2
               export DS4_METAL_SELECTED_ID_POLL=${DS4_METAL_SELECTED_ID_POLL:-1}
               set -- "$@" --ssd-streaming
           fi ;;
    esac
    if [ "$dry" = 1 ]; then
        echo "cd $HERE && caffeinate -i ./ds4-server $*"
        return
    fi
    ensure_binaries
    echo "dstar: $(basename "$model"), context $ctx, http://$HOST:$PORT/v1" >&2
    cd "$HERE"
    exec caffeinate -i ./ds4-server "$@"
}

cmd_serve() {
    local ctx="" mtp=1 vision=1 dry=0 model="" power=""
    while [ $# -gt 0 ]; do
        case $1 in
            --ctx) [ $# -ge 2 ] || die "--ctx needs a value"; ctx=$(parse_ctx "$2"); shift ;;
            --port) [ $# -ge 2 ] || die "--port needs a value"; PORT=$2; shift ;;
            --lan) HOST=0.0.0.0 ;;
            --no-mtp) mtp=0 ;;
            --no-vision) vision=0 ;;
            --power) [ $# -ge 2 ] || die "--power needs a value"; power=$(parse_power "$2") || exit 1; shift ;;
            --quant) [ $# -ge 2 ] || die "--quant needs q2, iq3 or iq3s"; QUANT=$2; shift ;;
            --dry-run) dry=1 ;;
            --model) [ $# -ge 2 ] || die "--model needs a file"; model=$(model_path "$2") || exit 1; shift ;;
            --) shift; break ;;
            -*) die "serve: unknown option $1 (see: dstar help)" ;;
            *) model=$(model_path "$1") || exit 1 ;;
            *) die "serve: unknown option $1 (see: dstar help)" ;;
        esac
        shift
    done
    if [ -n "$power" ]; then set -- --power "$power" "$@"; fi
    check_machine
    if [ -n "$model" ]; then serve_other "$model" "$ctx" "$dry" "$@"; return; fi
    locate_files
    [ -f "$F_SHARD1" ] && [ -f "$F_SHARD2" ] || die "the $QUANT model is not in $QDIR; run: $0 pull --quant $QUANT"
    [ "$dry" = 1 ] || ensure_binaries
    [ "$RAM_GB" -ge 60 ] || echo "dstar: this Mac has $RAM_GB GB of RAM; the model is tuned for 64 GB and may not fit" >&2

    # Without --ctx take the largest window that leaves the rest of the
    # system 8 GB (the iq3 quant on 64 GB fits 262K, but then it swaps), and
    # step down again when the wired limit is lower, saying how to raise it.
    if [ -z "$ctx" ]; then
        local want c
        for want in 262144 131072 65536 32768; do
            [ $(( $(need_mib "$want") + 8192 )) -gt $(( RAM_GB * 1024 )) ] || break
        done
        if [ "$want" != 262144 ]; then
            echo "dstar: using a $(( want / 1000 ))K context, a larger one would leave the rest of the system too little memory." >&2
            echo "    --ctx N forces it." >&2
        fi
        ctx=$want
        for c in 262144 131072 65536 32768; do
            if [ "$c" -le "$want" ] && ctx_fits "$c"; then ctx=$c; break; fi
        done
        if [ "$ctx" != "$want" ]; then
            echo "dstar: using a $(( ctx / 1000 ))K context. For $(( want / 1000 ))K run this once per boot, then restart:" >&2
            echo "    $(sysctl_hint "$want")" >&2
        fi
    fi
    local max_mib=$(( RAM_GB * 1024 - 4096 ))
    [ "$(need_mib "$ctx")" -le "$max_mib" ] ||
        die "a context of $ctx tokens needs about $(need_mib "$ctx") MiB of GPU memory, more than this Mac can give"
    if ! ctx_fits "$ctx"; then
        echo "dstar: a context of $ctx tokens needs a higher GPU memory limit. Run:" >&2
        echo "    $(sysctl_hint "$ctx")" >&2
        exit 1
    fi

    # Past the native 262144 window the positions need YaRN scaling. A
    # checkpoint only loads under the factor it was written with, so those
    # contexts keep their own cache directory and write snapshots less often.
    local kv_dir=$HOME/.ds4/server-kv kv_mb=12288 kv_every=10000
    if [ "$ctx" -gt 262144 ]; then
        export DS4_QWEN4_YARN_FACTOR=${YARN:-2}
        kv_dir=$HOME/.ds4/server-kv-yarn$DS4_QWEN4_YARN_FACTOR
        kv_mb=40960
        kv_every=32768
    fi

    export DS4_QWEN_NGRAM_GGUF=$F_SHARD2
    export DS4_QWEN4_MOE_TAILS=1
    set -- --ctx "$ctx" --prefill-chunk 2048 --host "$HOST" --port "$PORT" \
        --kv-disk-dir "$kv_dir" --kv-disk-space-mb "$kv_mb" \
        --kv-cache-continued-interval-tokens "$kv_every" "$@"
    if [ "$mtp" = 1 ] && [ -f "$F_MTP" ]; then
        export DS4_QWEN_MTP_GGUF=$F_MTP
        set -- --mtp "$@"
    elif [ "$mtp" = 1 ]; then
        echo "dstar: no MTP block in $MODELS, decoding without it (run: $0 pull)" >&2
    fi
    if [ "$vision" = 1 ] && [ -f "$F_VISION" ]; then set -- --vision "$F_VISION" "$@"; fi

    if [ "$dry" = 1 ]; then
        env | grep '^DS4_QWEN' | sort
        echo "cd $HERE && caffeinate -i ./ds4-server -m $F_SHARD1 $*"
        return
    fi
    echo "dstar: $QUANT, context $ctx, http://$HOST:$PORT/v1" >&2
    cd "$HERE"   # the Metal shaders load from ./metal
    exec caffeinate -i ./ds4-server -m "$F_SHARD1" "$@"
}

cmd_chat() {
    local model="" power=""
    while :; do
        case ${1:-} in
            --quant) [ $# -ge 2 ] || die "--quant needs q2, iq3 or iq3s"; QUANT=$2 ;;
            --power) [ $# -ge 2 ] || die "--power needs a value"; power=$(parse_power "$2") || exit 1 ;;
            *) break ;;
        esac
        shift 2
    done
    case ${1:-} in
        --model) [ $# -ge 2 ] || die "--model needs a file"; model=$(model_path "$2") || exit 1; shift 2 ;;
        ""|-*) ;;
        *) model=$(model_path "$1") || exit 1; shift ;;
    esac
    if [ "${1:-}" = -- ]; then shift; fi
    if [ -n "$power" ]; then set -- --power "$power" "$@"; fi
    check_machine
    if [ -n "$model" ]; then
        ensure_binaries
        case " $* " in
            *" --ssd-streaming "*) ;;
            *) if needs_streaming "$model"; then
                   export DS4_METAL_SELECTED_ID_POLL=${DS4_METAL_SELECTED_ID_POLL:-1}
                   set -- --ssd-streaming "$@"
               fi ;;
        esac
        cd "$HERE"
        exec ./ds4 -m "$model" "$@"
    fi
    locate_files
    [ -f "$F_SHARD1" ] && [ -f "$F_SHARD2" ] || die "the $QUANT model is not in $QDIR; run: $0 pull --quant $QUANT"
    ensure_binaries
    export DS4_QWEN_NGRAM_GGUF=$F_SHARD2
    if [ -f "$F_MTP" ]; then
        export DS4_QWEN_MTP_GGUF=$F_MTP
        set -- --mtp "$@"
    fi
    cd "$HERE"
    exec ./ds4 -m "$F_SHARD1" --ctx 32768 "$@"
}

cmd_doctor() {
    local bad=0 limit
    if [ "${1:-}" = --quant ]; then QUANT=${2:-}; fi
    check_machine
    locate_files
    line() { printf '%-22s %s\n' "$1" "$2"; }
    line "quant" "$QUANT"
    line "machine" "$(sysctl -n machdep.cpu.brand_string), $RAM_GB GB"
    [ "$RAM_GB" -ge 60 ] || { line "" "less than 64 GB: the model may not fit"; bad=1; }
    for b in ds4 ds4-server; do
        if [ -x "$HERE/$b" ]; then line "$b" "ok"; else line "$b" "missing (serve builds it from source)"; fi
    done
    [ -d "$HERE/metal" ] && line "metal shaders" "ok" || { line "metal shaders" "missing $HERE/metal"; bad=1; }
    for f in "$F_SHARD1" "$F_SHARD2"; do
        if [ -f "$f" ]; then line "model" "$(basename "$f")"; else line "model" "missing $(basename "$f") (dstar pull)"; bad=1; fi
    done
    [ -f "$F_MTP" ] && line "MTP block" "ok" || line "MTP block" "missing, decoding will be slower (dstar pull)"
    [ -f "$F_VISION" ] && line "vision encoder" "ok" || line "vision encoder" "missing, images are off (dstar pull)"
    limit=$(wired_limit)
    line "wired limit" "$([ "$limit" = 0 ] && echo "system default" || echo "$limit MiB")"
    for c in 32768 131072 262144 400000 524288; do
        if ctx_fits "$c"; then line "context $c" "fits"
        elif [ "$(need_mib "$c")" -le $(( RAM_GB * 1024 - 4096 )) ]; then line "context $c" "needs: $(sysctl_hint "$c")"
        else line "context $c" "does not fit in $RAM_GB GB"; fi
    done
    # The largest window each quant can hold on this machine with 8 GB left
    # for the rest of the system.
    local q best
    for q in q2 iq3 iq3s; do
        QUANT=$q; locate_files; best=""
        for c in 32768 131072 262144 400000 524288; do
            [ $(( $(need_mib "$c") + 8192 )) -gt $(( RAM_GB * 1024 )) ] || best=$c
        done
        line "quant $q" "$([ -n "$best" ] && echo "up to $best tokens" || echo "too large for $RAM_GB GB with room to spare")$([ -f "$F_SHARD1" ] && echo ", downloaded")"
    done
    if curl -s -m 2 "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1; then
        line "server" "running on port $PORT"
    else
        line "server" "not running on port $PORT"
    fi
    return $bad
}

cmd_link() {
    mkdir -p "$BIN_DIR"
    if [ -e "$BIN_DIR/dstar" ] && [ ! -L "$BIN_DIR/dstar" ]; then
        die "$BIN_DIR/dstar exists and is not a link; remove it first"
    fi
    ln -sf "$HERE/dstar" "$BIN_DIR/dstar"
    echo "dstar -> $HERE/dstar"
    case ":$PATH:" in
        *":$BIN_DIR:"*) ;;
        *) echo "$BIN_DIR is not on your PATH. Add this line to ~/.zshrc and open a new terminal:"
           echo "    export PATH=\"$BIN_DIR:\$PATH\"" ;;
    esac
}

cmd_opencode() {
    cat <<EOF
Merge this into ~/.config/opencode/opencode.json under "provider":

  "ds4": {
    "name": "DwarfStar (local)",
    "npm": "@ai-sdk/openai-compatible",
    "options": {
      "baseURL": "http://127.0.0.1:$PORT/v1",
      "apiKey": "local",
      "timeout": false,
      "chunkTimeout": 900000
    },
    "models": {
      "qwen3.8-flash-next": {
        "name": "Qwen3.8 Flash Next Q2 (DwarfStar)",
        "limit": { "context": 262144, "output": 32768 },
        "reasoning": true,
        "tool_call": true,
        "temperature": true,
        "attachment": true,
        "modalities": { "input": ["text", "image"], "output": ["text"] },
        "options": { "reasoningEffort": "xhigh" },
        "variants": {
          "xhigh": { "reasoningEffort": "xhigh" },
          "medium": { "reasoningEffort": "medium" },
          "low": { "reasoningEffort": "low" },
          "none": { "reasoningEffort": "none" },
          "high": { "disabled": true },
          "minimal": { "disabled": true }
        }
      }
    }
  }

Set "context" to the value the server was started with. Then pick the model
ds4/qwen3.8-flash-next in OpenCode.
EOF
}

case ${1:-help} in
    pull) shift; cmd_pull "$@" ;;
    serve) shift; cmd_serve "$@" ;;
    chat) shift; cmd_chat "$@" ;;
    models) other_models ;;
    doctor) shift; cmd_doctor "$@" ;;
    opencode) shift; cmd_opencode ;;
    link) cmd_link ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
esac
